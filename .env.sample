# pushframe configuration sample — copy to .env and fill in.
# PUSHFRAME_* is the primary spelling; legacy AURA_* is still read (one release of grace).

PUSHFRAME_PASSWORD=your_password
PUSHFRAME_EMAIL=your_email

# Optional — write budget & geo guard (see README):
# PUSHFRAME_COUNTRY=FR
# PUSHFRAME_WRITE_BUDGET_CAPACITY=30

# Optional — Google album sync (google-link needs the dedicated Chrome profile):
# PUSHFRAME_PROBE_CHROME_PROFILE=~/.config/pushframe/chrome-profile
